---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title="Enquire" description={`Enquire about a commission with ${site.name}, photographer in Cape Town. Editorial, portrait, architecture and still life.`}>
  <section class="wrap pt-28 md:pt-40">
    <h1 class="text-3xl">Enquire</h1>
    <p class="mt-8 max-w-[48ch] text-lg text-muted">A few lines about the project is enough to start. I reply within two working days.</p>
  </section>
  <section class="wrap mt-20 grid gap-16 md:grid-cols-12 md:gap-8">
    <form class="md:col-span-7" method="post" action={site.formEndpoint || undefined} data-enquiry data-endpoint={site.formEndpoint} data-email={site.email} novalidate>
      <div class="grid gap-8 sm:grid-cols-2">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <p class="error" id="name-error">Please add your name.</p>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="error" id="email-error">Please add an email address I can reply to.</p>
        </div>
        <div class="field">
          <label for="type">Type of commission</label>
          <select id="type" name="type">
            <option>Editorial</option>
            <option>Portrait</option>
            <option>Architecture or interiors</option>
            <option>Still life or product</option>
            <option>Prints</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="dates">Dates, if known</label>
          <input id="dates" name="dates" type="text" placeholder="e.g. second week of March" />
        </div>
        <div class="field sm:col-span-2">
          <label for="message">About the project</label>
          <textarea id="message" name="message" rows="6" required></textarea>
          <p class="help">Where it is, who it is for, and roughly how many pictures you need.</p>
          <p class="error" id="message-error">Please tell me a little about the project.</p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <button type="submit" class="btn">Send enquiry</button>
        <p class="text-xs text-muted" data-form-status aria-live="polite"></p>
      </div>
    </form>
    <aside class="md:col-span-4 md:col-start-9">
      <dl class="grid gap-6 text-base">
        <div>
          <dt class="text-xs text-muted">Email</dt>
          <dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Phone</dt>
          <dd><a class="link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Studio</dt>
          <dd>{site.city}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Availability</dt>
          <dd>Booking from February 2027. Short editorial jobs can sometimes be fitted in sooner.</dd>
        </div>
      </dl>
    </aside>
  </section>
</Base>
<script>
  function bind() {
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  if (form && !form.dataset.bound) {
    form.dataset.bound = '1';
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';
    const fields = ['name', 'email', 'message'] as const;

    const validate = () => {
      let ok = true;
      for (const id of fields) {
        const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`)!;
        const wrap = input.closest('.field')!;
        const valid = input.checkValidity();
        wrap.classList.toggle('is-invalid', !valid);
        input.setAttribute('aria-invalid', String(!valid));
        input.setAttribute('aria-describedby', valid ? '' : `${id}-error`);
        if (!valid && ok) { input.focus(); ok = false; }
      }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const data = new FormData(form);
      if (!endpoint) {
        // No endpoint configured yet: hand the message to the visitor's email client.
        const subject = encodeURIComponent(`Enquiry: ${data.get('type')}`);
        const body = encodeURIComponent(
          `Name: ${data.get('name')}\nEmail: ${data.get('email')}\nDates: ${data.get('dates') || 'not set'}\n\n${data.get('message')}`,
        );
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        status.textContent = 'Opening your email client.';
        return;
      }
      status.textContent = 'Sending.';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Thanks. Your enquiry has been sent.';
      } catch {
        status.textContent = `Something went wrong. Please email ${email} instead.`;
      }
    });
  }
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
