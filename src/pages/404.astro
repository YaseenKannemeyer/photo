---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <section class="wrap flex min-h-[70dvh] flex-col justify-center pt-28">
    <h1 class="text-3xl">Nothing hangs here.</h1>
    <p class="mt-6 max-w-[48ch] text-lg text-muted">The page you were after has moved or never existed. The work is still where it should be.</p>
    <div class="mt-8 flex flex-wrap gap-6">
      <a href="/work" class="btn">View the work</a>
      <a href="/" class="btn-quiet">Home</a>
    </div>
  </section>
</Base>
