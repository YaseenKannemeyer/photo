---
import { Icon } from 'astro-icon/components';
---
<dialog
  id="lightbox"
  class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 backdrop:bg-(--scrim)"
  aria-label="Photograph"
  data-lenis-prevent
>
  <div class="relative flex h-full w-full flex-col items-center justify-center bg-(--scrim)">
    <button type="button" class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center text-text hover:text-accent" data-lb-close aria-label="Close">
      <Icon name="ph:x" class="h-6 w-6" aria-hidden="true" />
    </button>
    <button type="button" class="absolute top-1/2 left-2 z-10 flex h-14 w-14 -translate-y-1/2 items-center justify-center text-text hover:text-accent md:left-6" data-lb-prev aria-label="Previous photograph">
      <Icon name="ph:arrow-left" class="h-6 w-6" aria-hidden="true" />
    </button>
    <button type="button" class="absolute top-1/2 right-2 z-10 flex h-14 w-14 -translate-y-1/2 items-center justify-center text-text hover:text-accent md:right-6" data-lb-next aria-label="Next photograph">
      <Icon name="ph:arrow-right" class="h-6 w-6" aria-hidden="true" />
    </button>
    <figure class="flex h-full w-full flex-col items-center justify-center gap-4 px-14 py-16">
      <img data-lb-img src="" alt="" class="max-h-full max-w-full object-contain transition-opacity duration-300" />
      <figcaption class="flex gap-6 text-xs text-muted">
        <span data-lb-caption class="text-text"></span>
        <span data-lb-count class="text-accent"></span>
      </figcaption>
    </figure>
  </div>
</dialog>
<script>
  import { stopScroll } from '../scripts/engine';
  function bind() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-item]'));
    if (!dialog || !items.length || dialog.dataset.bound) return;
    dialog.dataset.bound = '1';
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const el = items[current];
      const swap = () => {
        img.src = el.dataset.full || '';
        img.alt = el.dataset.alt || '';
        cap.textContent = el.dataset.caption || '';
        count.textContent = `${current + 1} of ${items.length}`;
        img.onload = () => (img.style.opacity = '1');
      };
      if (reduce) return swap();
      img.style.opacity = '0';
      setTimeout(swap, 120);
    };
    const preload = (i: number) => {
      const el = items[(i + items.length) % items.length];
      if (el?.dataset.full) new Image().src = el.dataset.full;
    };
    const open = (i: number) => {
      opener = items[i];
      show(i);
      preload(i + 1);
      preload(i - 1);
      dialog.showModal();
      document.body.classList.add('lightbox-open');
      stopScroll(true);
    };
    items.forEach((el, i) => el.addEventListener('click', () => open(i)));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => { show(current - 1); preload(current - 1); });
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => { show(current + 1); preload(current + 1); });
    dialog.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName !== 'BUTTON' && !(e.target as HTMLElement).closest('button') && (e.target as HTMLElement).tagName !== 'IMG') dialog.close(); });
    dialog.addEventListener('close', () => { document.body.classList.remove('lightbox-open'); stopScroll(false); opener?.focus(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); preload(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); preload(current - 1); }
    });
    let x0 = 0;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 48) show(current + (dx < 0 ? 1 : -1));
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
